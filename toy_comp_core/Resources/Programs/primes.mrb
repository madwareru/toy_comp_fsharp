limit = 50;
n = 2;

while n <= limit:
    d = 2;
    prime = 1;
    
    while d < n:
        rest = n;
        
        while d <= rest:
            rest = rest - d;
        end;
        
        prime = prime * (0 < rest);
        d = d + 1;
    end;
    
    if prime == 1:
        outn(n);
    end;
    
    n = n + 1;
end;