size = 27;
y = 0;

while y < size:
    x = 0;
    while x < size:
        xx = x;
        yy = y;
        hole = 0;
        digit = 0;

        while digit < 3:
            rx = xx;
            qx = 0;

            while 3 <= rx:
                rx = rx - 3;
                qx = qx + 1;
            end;

            ry = yy;
            qy = 0;
            
            while 3 <= ry:
                ry = ry - 3;
                qy = qy + 1;
            end;

            hole = hole + (1 - hole) * (rx == 1) * (ry == 1);

            xx = qx;
            yy = qy;
            digit = digit + 1;
        end;

        out(35 - 3 * hole);

        x = x + 1;
    end;

    out(10);
    y = y + 1;
end;