<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>toy_comp_core</RootNamespace>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ISAShared.fs" />
    <Compile Include="ISAMem.fs" />
    <Compile Include="ISAStack.fs" />
    <Compile Include="ISAReg.fs" />
    <Compile Include="ResourceUtility.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Asm\fact.asmm" />
    <EmbeddedResource Include="Resources\Asm\fib.asmm" />
    <EmbeddedResource Include="Resources\Asm\sierpinski.asmm" />
    <EmbeddedResource Include="Resources\Asm\carpet.asmm" />
    <EmbeddedResource Include="Resources\Asm\mandelbrot.asmm" />
    <EmbeddedResource Include="Resources\Asm\primes.asmm" />
    <EmbeddedResource Include="Resources\Asm\fact.asms" />
    <EmbeddedResource Include="Resources\Asm\carpet.asms" />
    <EmbeddedResource Include="Resources\Asm\fib.asms" />
    <EmbeddedResource Include="Resources\Asm\mandelbrot.asms" />
    <EmbeddedResource Include="Resources\Asm\primes.asms" />
    <EmbeddedResource Include="Resources\Asm\sierpinski.asms" />
    <EmbeddedResource Include="Resources\Asm\fact.asmr" />
    <EmbeddedResource Include="Resources\Asm\carpet.asmr" />
    <EmbeddedResource Include="Resources\Asm\fib.asmr" />
    <EmbeddedResource Include="Resources\Asm\mandelbrot.asmr" />
    <EmbeddedResource Include="Resources\Asm\primes.asmr" />
    <EmbeddedResource Include="Resources\Asm\sierpinski.asmr" />
    <EmbeddedResource Include="Resources\ExpectedOuts\carpet.txt" />
    <EmbeddedResource Include="Resources\ExpectedOuts\fact.txt" />
    <EmbeddedResource Include="Resources\ExpectedOuts\fib.txt" />
    <EmbeddedResource Include="Resources\ExpectedOuts\mandelbrot.txt" />
    <EmbeddedResource Include="Resources\ExpectedOuts\primes.txt" />
    <EmbeddedResource Include="Resources\ExpectedOuts\sierpinski.txt" />
  </ItemGroup>

</Project>
