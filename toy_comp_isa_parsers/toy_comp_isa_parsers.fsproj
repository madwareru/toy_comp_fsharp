<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>toy_comp_isa_parsers</RootNamespace>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FParsecShared.fs" />
    <Compile Include="ISAMemParser.fs" />
    <Compile Include="ISAStackParser.fs" />
    <Compile Include="ISARegParser.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\toy_comp_core\toy_comp_core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>

</Project>
