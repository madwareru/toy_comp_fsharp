<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>toy_comp_isa_interpreter_tests</RootNamespace>

        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ISAMemInterpreterTests.fs" />
        <Compile Include="ISAStackInterpreterTests.fs" />
        <Compile Include="ISARegInterpreterTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\toy_comp_core\toy_comp_core.fsproj" />
        <ProjectReference Include="..\toy_comp_isa_parsers\toy_comp_isa_parsers.fsproj" />
        <ProjectReference Include="..\toy_comp_isa_interpreters\toy_comp_isa_interpreters.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    </ItemGroup>
</Project>
