<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>toy_comp_isa_interpreters</RootNamespace>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ISAMemInterpreter.fs" />
    <Compile Include="ISAStackInterpreter.fs" />
    <Compile Include="ISARegInterpreter.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\toy_comp_core\toy_comp_core.fsproj" />
  </ItemGroup>
</Project>
